{
  "name": "push-your-luck-multiplayer",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "build": "esbuild client/src/main.tsx --bundle --minify --target=es2022 --outfile=client/static/js/client.js",
    "dev": "wrangler dev",
    "deploy": "env -u CLOUDFLARE_API_TOKEN wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply probability-simulator --local",
    "db:migrate:remote": "env -u CLOUDFLARE_API_TOKEN wrangler d1 migrations apply probability-simulator --remote",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p client"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "jose": "^6.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "spin-wheel": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  }
}
